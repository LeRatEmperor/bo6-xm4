"VertexLitGeneric"
{
    "$basetexture" "bo6\xm4\556_ammo_rgb"
    "$bumpmap" "bo6\xm4\556_ammo_n"
    "$phongexponenttexture" "bo6\xm4\556_ammo_e"

    /////////////////
    "$color2" "[0 0 0]"                                     //do not touch this
    "$blendtintbybasealpha" "1"                             //do not touch this
    /////////////////

    "$phong" "1"
    "$phongboost" "1"
    "$phongalbedotint" "1"
    "$phongalbedoboost" "20"                                //toy around with this
    "$phongfresnelranges" "[1 0.1 0]"

    //rimlight doesn't properly show in hlmv, make sure you're changing these values in game
    "$rimlight" "1"
    "$rimlightexponent" "100"
    "$rimmask" "1"
    "$rimlightboost" "0.35"
       
    /////////////////
    "$normalmapalphaenvmapmask" "1"                         //do not touch this
    /////////////////

    "$envmap" "envmaps\specularity_00"
    "$envmaptint" "[0.467 0.345 0.031]"                 

    //remove this if not using MWB
    "Proxies"
    {
        "MwEnvMapTint"
        {
            "specularity" "0.5"             //0.25, 0.5, 0.75, 1
            "envmap"	"viper/shared/envmaps/metal_generic_006"
            "color"	"[.3 .15 .1]"
            "min" "0"
            "max" "0.5"                       //change this if too bright in game
        }
    }
}